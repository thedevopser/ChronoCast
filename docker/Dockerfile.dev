# Image de développement ChronoCast.
#
# Rôle : exécuter lint, typecheck et la suite de tests. Elle n'embarque NI Electron
# NI Chromium : tout `src/core/**` est volontairement dépourvu d'import `electron`,
# ce qui rend l'intégralité de la logique testable dans un Node nu.
#
# La cible de distribution est Windows ; ce conteneur Linux ne sert qu'à la
# vérification. Le packaging `.exe` se fait via docker/Dockerfile.build.
FROM node:22-bookworm-slim

# git : requis par certains outils npm pour résoudre les dépendances et lire la révision.
# ca-certificates : requis pour les appels HTTPS sortants (registre npm).
RUN apt-get update \
    && apt-get install --no-install-recommends --yes git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# node_modules est un volume nommé (voir docker/compose.yml). Docker initialise un
# volume vide à partir du contenu ET des permissions du répertoire présent dans
# l'image : créer ce répertoire ici, appartenant à `node`, est donc ce qui rend le
# volume inscriptible par un utilisateur non privilégié.
RUN mkdir -p /app/node_modules && chown -R node:node /app

# L'utilisateur `node` (uid 1000) existe déjà dans l'image officielle et correspond
# à l'uid de l'hôte : les fichiers créés dans le volume monté restent éditables
# depuis l'hôte, sans fichiers appartenant à root.
USER node

# Electron n'est jamais téléchargé dans cette image : inutile pour les tests,
# et cela économise ~150 Mo à chaque construction.
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1 \
    npm_config_fund=false \
    npm_config_audit=false \
    CI=true

CMD ["node", "--version"]
